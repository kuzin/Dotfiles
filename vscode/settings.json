{
  "editor.minimap.enabled": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "window.zoomLevel": -1,
  "security.workspace.trust.untrustedFiles": "open",
  "diffEditor.ignoreTrimWhitespace": false,
  "githubPullRequests.fileListLayout": "tree",
  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "prettier.documentSelectors": [
    "html"
  ],
  "prettier.withNodeModules": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.tools.urls.autoApprove": {
    "https://developers.home.google.com/automations/schema/reference": true,
    "https://developers.home.google.com/automations/schema": true,
    "https://developers.home.google.com/automations": true,
    "https://developers.home.google.com": true,
    "https://*.home.google.com": true,
    "https://*.google.com": true,
    "https://developers.hubspot.com/docs/cms/hubl/tags#from-import": true,
    "https://developers.hubspot.com/docs/cms/hubl": true,
    "https://developers.hubspot.com/docs/cms": true,
    "https://developers.hubspot.com/docs": true,
    "https://developers.hubspot.com": true,
    "https://*.hubspot.com": true,
    "https://developers.hubspot.com/docs/cms/building-blocks/templates/macros": true,
    "https://developers.hubspot.com/docs/cms/building-blocks/templates": true,
    "https://developers.hubspot.com/docs/cms/building-blocks": true,
  },
  "workbench.iconTheme": "catppuccin-macchiato",
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.lineHeight": 1.6,
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.formatOnSave": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "files.trimTrailingWhitespace": true,
  "workbench.list.smoothScrolling": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "yarn.lock, .yarnrc.yml, .eslintrc*, eslint.config.*, .prettierrc*, prettier.config.*, stylelint.config.*, postcss.config.*, babel.config.*, jsconfig.json, tsconfig.json",
  },
  "extensions.ignoreRecommendations": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "chat.tools.global.autoApprove": true,
  "workbench.browser.enableChatTools": true,
  "chat.agent.maxRequests": 100,
  "chat.viewSessions.orientation": "stacked",
  "chat.mcp.gallery.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "workbench.browser.pageZoom": "100%",
  "workbench.browser.showInTitleBar": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.environmentVariables": [],
}

# Per-machine overrides (untracked; missing file is skipped).
# ssh uses first-match-wins, so local settings override shared ones.
Include ~/.ssh/config.local

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/github
  # Reuse one connection per host — repeat ssh/scp are instant for 10m
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
